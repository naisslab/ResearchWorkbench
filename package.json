{
  "name": "research-native-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A local research workbench for projects, papers, terminals, and LaTeX",
  "author": "Research Workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/smoke.mjs",
    "test:git-ui": "node scripts/git-workflow-smoke.mjs",
    "test:deadlines": "node scripts/deadlines-smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && electron-builder --mac dir",
    "dist": "npm run build && electron-builder --mac dmg",
    "format": "prettier --write src electron scripts/*.mjs tests vite.config.ts package.json tsconfig.json",
    "test:pdf-ui": "node scripts/pdf-annotations-smoke.mjs",
    "test:ai-ui": "node scripts/ai-agent-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/lint": "^6.9.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@openai/codex": "0.160.0",
    "@uiw/react-codemirror": "^4.25.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "jose": "^6.2.12",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.research.workbench",
    "productName": "Research Workbench",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@openai/codex*/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Research Workbench"
    },
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false
  }
}
