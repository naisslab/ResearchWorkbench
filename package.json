{
  "name": "research-native-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A local research workbench for projects, papers, terminals, and LaTeX",
  "author": "Research Workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/build-dictation.mjs && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build-dictation.mjs && tsc -b && vite build",
    "start": "node scripts/build-dictation.mjs && electron .",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild -f -w node-pty",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/smoke.mjs",
    "test:git-ui": "node scripts/git-workflow-smoke.mjs",
    "test:deadlines": "node scripts/deadlines-smoke.mjs",
    "test:pdf-ui": "node scripts/pdf-annotations-smoke.mjs",
    "test:synctex-ui": "node scripts/synctex-smoke.mjs",
    "test:ai-ui": "node scripts/ai-agent-smoke.mjs",
    "test:native-ui": "node scripts/ai-native-smoke.mjs",
    "test:images-ui": "node scripts/ai-images-smoke.mjs",
    "test:review-ui": "node scripts/ai-review-smoke.mjs",
    "test:layout-ui": "node scripts/layout-smoke.mjs",
    "test:e2e": "npm run test:ui && npm run test:git-ui && npm run test:deadlines && npm run test:pdf-ui && npm run test:synctex-ui && npm run test:layout-ui",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && electron-builder --mac dir --publish never",
    "dist": "npm run build && electron-builder --mac dmg --publish never",
    "format": "prettier --write src electron scripts/*.mjs tests vite.config.ts package.json tsconfig.json",
    "test:continuity-ui": "node scripts/continuity-smoke.mjs",
    "test:writing-ui": "node scripts/writing-smoke.mjs",
    "test:writing-agent-ui": "node scripts/writing-agent-smoke.mjs",
    "test:finder-ui": "node scripts/finder-smoke.mjs",
    "test:connection-ui": "node scripts/connection-smoke.mjs",
    "test:project-continuity-ui": "node scripts/project-continuity-smoke.mjs",
    "test:dictation-native": "node scripts/dictation-native-smoke.mjs",
    "test:reorder-ui": "node scripts/reorder-smoke.mjs",
    "test:workspace-agent-ui": "node scripts/workspace-agent-smoke.mjs",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "check:release": "node scripts/check-release.mjs",
    "dist:release": "node scripts/check-release.mjs --configuration && npm run build && electron-builder --config build/electron-builder.release.cjs --mac dmg --publish never && node scripts/check-release.mjs --artifacts",
    "test:release-ui": "node scripts/release-smoke.mjs",
    "test:portfolio-ui": "node scripts/pi-workflow-smoke.mjs",
    "test:packaged-ui": "node scripts/packaged-smoke.mjs"
  },
  "dependencies": {
    "@openai/codex": "0.160.0",
    "jose": "^6.2.12",
    "js-yaml": "^4.3.2",
    "node-pty": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electron/rebuild": "^4.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uiw/react-codemirror": "^4.25.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.468.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.2.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "build": {
    "appId": "com.research.workbench",
    "productName": "Research Workbench",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/pdf-lib/{dist,es,src,ts3.4}/**",
      "!node_modules/pdfjs-dist/{build,web,image_decoders,types}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/pdfjs-dist/legacy/build/{*.map,*.min.mjs,pdf.sandbox*}",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!electron/research-catalog.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@openai/codex*/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Turn your speech into editable text when you start dictation.",
        "NSSpeechRecognitionUsageDescription": "Transcribe speech into editable text on this Mac."
      },
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "Research Workbench"
    },
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/native/research-dictation",
        "to": "research-dictation"
      },
      {
        "from": "LICENSE",
        "to": "licenses/Research-Workbench-LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/@fontsource-variable/inter/LICENSE",
        "to": "licenses/Inter-LICENSE.txt"
      },
      {
        "from": "node_modules/@fontsource-variable/jetbrains-mono/LICENSE",
        "to": "licenses/JetBrains-Mono-LICENSE.txt"
      }
    ],
    "artifactName": "Research-Workbench-${version}-${arch}.${ext}"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <26",
    "npm": ">=11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/naisslab/ResearchWorkbench.git"
  },
  "homepage": "https://github.com/naisslab/ResearchWorkbench#readme",
  "bugs": {
    "url": "https://github.com/naisslab/ResearchWorkbench/issues"
  }
}
